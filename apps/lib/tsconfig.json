{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["bun", "react", "react-dom"],
    "paths": {
      // entries import each other by package name so the bundler keeps them external and there is one
      // copy of each at runtime; in-repo (type-check, tests) those names resolve back to the source
      "react-oauth-oidc": ["./src/index.ts"],
      "react-oauth-oidc/core": ["./src/core/index.ts"],
      "react-oauth-oidc/axios": ["./src/axios/index.ts"]
    }
  },
  "include": ["src/**/*"]
}
