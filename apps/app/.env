VITE_THEME=light

# Point these at your IdP. With only an issuer set, the endpoints are discovered from
# <issuer>/.well-known/openid-configuration on the first login.
# VITE_OAUTH_ISSUER_PATH=https://accounts.google.com
# VITE_OAUTH_CLIENT_ID=<your_client_id>
# VITE_OAUTH_SCOPE=openid profile email
# VITE_OAUTH_TYPE=code
# VITE_OAUTH_PKCE=true
